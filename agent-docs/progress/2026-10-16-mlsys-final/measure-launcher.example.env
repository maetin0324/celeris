# measure-launcher.sh の env 例（KEY=VALUE の sh 形式。秘密値は書かない。相対 path はこのファイルの dir 基準）。
# [operator 入力待ち] と書いた値は実値で決まらないので、置換するまで prepare / preflight が拒否する。
MANIFEST=final.json                                  # H1 後に B/C harness_version・A harness_version を実値へ置換済みのもの
DAEMON_CONFIG=<operator 入力待ち: measure-daemon.example.toml を複製した abs path>
NORMAL_CONFIG=~/.config/celeris/config.toml          # 突き合わせ専用。読むだけ
CANARIES=<operator 入力待ち: canaries.json の path>
TASK_TEMPLATE=task-template.json
A_ACCOUNT=<operator 入力待ち: claude_oauth の account_id>
CELERIS_BIN=<operator 入力待ち: 昇格した release の celeris 実行 file の abs path>
RELEASE=<operator 入力待ち: 昇格した release の sha12>
OUT=<operator 入力待ち: NFS 外 abs path>/final-out
STATE_DIR=<operator 入力待ち: NFS 外 abs path>/measure-state
CAP_ENV=<operator 入力待ち: cap-env.json の abs path（toolchain 内容 pin。env-lock/3 に再帰内容 hash が入る）>
MATERIALS_SRC=<operator 入力待ち: §4 で作る dir>
KB_SRC=<operator 入力待ち: §4 で作る dir>
REPO_SRC=<operator 入力待ち: §4 で作る dir>
INPUTS_SRC=<operator 入力待ち: §4 で作る dir>
CAMPAIGN_BIN=<operator 入力待ち: celeris-campaign の abs path（DAEMON_CONFIG の cap-probe command と同じ実体）>
CASES_ROOT=crates/campaign/cases
GRADER_ROOT=crates/campaign/fixtures/grader-private
GRADE_CASES_ROOT=agent-docs/progress/2026-10-16-mlsys-final/grade-case
