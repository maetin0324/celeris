diff --git a/crates/script-runtime/src/overhead_probe.rs b/crates/script-runtime/src/overhead_probe.rs
new file mode 100644
--- /dev/null
+++ b/crates/script-runtime/src/overhead_probe.rs
@@ -0,0 +1,14 @@
+//! S6 overhead の測定専用（repo には入れない）。直列の呼び出しの時刻を残す。
+use std::sync::OnceLock;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::time::Instant;
+pub const SENT: usize = 0;
+pub const DEQUEUED: usize = 1;
+pub const ARGS_DONE: usize = 2;
+pub const JS_DONE: usize = 3;
+pub const OUT_DONE: usize = 4;
+static BASE: OnceLock<Instant> = OnceLock::new();
+static STAMPS: [AtomicU64; 5] = [const { AtomicU64::new(0) }; 5];
+pub fn now_ns() -> u64 { BASE.get_or_init(Instant::now).elapsed().as_nanos() as u64 }
+pub fn stamp(i: usize) { STAMPS[i].store(now_ns(), Ordering::SeqCst); }
+pub fn read() -> [u64; 5] { std::array::from_fn(|i| STAMPS[i].load(Ordering::SeqCst)) }
