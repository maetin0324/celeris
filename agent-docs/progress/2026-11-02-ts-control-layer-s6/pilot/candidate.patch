+/** ts-pilot の方針改善: 見出しに出す run の失敗の理由を 200 文字（code point）までにし、超えたら「…」で切る。
+ * 例外の stack など長い理由が digest の見出しを埋めないようにする。cards の理由は変えない。 */
+export const RUN_REASON_MAX_CHARS = 200;
+export function capRunReason(reason: string): string {
+  const chars = Array.from(reason);
+  return chars.length <= RUN_REASON_MAX_CHARS ? reason : `${chars.slice(0, RUN_REASON_MAX_CHARS).join("")}…`;
+}
