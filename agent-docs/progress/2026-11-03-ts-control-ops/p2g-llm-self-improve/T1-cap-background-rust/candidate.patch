+/// Longest background (in Unicode code points) the digest writes before clipping.
+const BACKGROUND_MAX_CHARS: usize = 300;
+
+/// The background as the digest shows it: the first 300 code points and `…` when longer.
+fn clip_background(background: &str) -> String {
+    match background.char_indices().nth(BACKGROUND_MAX_CHARS) {
+        Some((end, _)) => format!("{}…", &background[..end]),
+        None => background.to_owned(),
+    }
+}
