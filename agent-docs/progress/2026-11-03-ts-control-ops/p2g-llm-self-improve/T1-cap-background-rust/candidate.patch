+#[cfg(test)]
+mod background_clip_tests {
+    use super::*;
+
+    #[test]
+    fn digest_background_is_clipped_at_300_code_points() {
+        let exact = "あ".repeat(300);
+        assert_eq!(clip_background(&exact), exact);
+        let long = format!("{}{}", "あ".repeat(300), "いう");
+        assert_eq!(clip_background(&long), format!("{}…", "あ".repeat(300)));
+        // Astral characters count as one code point each, not two UTF-16 units.
+        let astral = "😀".repeat(301);
+        assert_eq!(clip_background(&astral), format!("{}…", "😀".repeat(300)));
+        assert_eq!(clip_background("short"), "short");
+    }
+}
