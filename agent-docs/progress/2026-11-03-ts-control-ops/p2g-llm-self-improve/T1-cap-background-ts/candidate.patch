 /** Rust の `cos_digest_message`: digest の文面と cards。 */
+/** `- 背景: ` の行に出す背景の上限（Unicode の code point）。 */
+const BACKGROUND_MAX_CODE_POINTS = 300;
+
+/** 背景が上限を超えたら、先頭の上限分の code point の後ろに `…` を足す。上限以下はそのまま返す。 */
+function capBackground(background: string): string {
+  // UTF-16 の長さは code point 数以上なので、上限以下ならここで返せる。
+  if (background.length <= BACKGROUND_MAX_CODE_POINTS) return background;
+  const codePoints = Array.from(background);
+  if (codePoints.length <= BACKGROUND_MAX_CODE_POINTS) return background;
+  return `${codePoints.slice(0, BACKGROUND_MAX_CODE_POINTS).join("")}…`;
+}
