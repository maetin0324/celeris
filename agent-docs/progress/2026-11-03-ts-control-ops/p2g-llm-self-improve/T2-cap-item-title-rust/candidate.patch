+#[test]
+fn digest_title_caps_long_summaries_at_80_code_points() {
+    use crate::chat::digest::cos_digest_message;
+    use crate::chat::triage::CosTriageItemReport;
+    let item = |summary: &str| CosTriageItemReport {
+        item_id: "item-1".into(),
+        thread_id: "thread-1".into(),
+        source_kind: "decision".into(),
+        source_key: "k1".into(),
+        source_revision: "1".into(),
+        state: "resolved".into(),
+        summary: summary.into(),
+        detail: String::new(),
+        reason: None,
+        operation_id: None,
+        run_id: Some("run-1".into()),
+        created_at: "2026-11-04T00:00:00Z".into(),
+        route: None,
+        decision: None,
+    };
+    let eighty = "あ".repeat(80);
+    assert_eq!(item(&eighty).digest_title(), eighty);
+    let long = format!("{eighty}い😀");
+    assert_eq!(item(&long).digest_title(), format!("{eighty}…"));
+    assert_eq!(item("   ").digest_title(), "decision:k1");
+    let (text, cards) = cos_digest_message("run-1", "completed", None, &[item(&long)]);
+    assert!(text.contains(&format!("\n### {eighty}…（")));
+    assert!(!text.contains(&long));
+    assert_eq!(cards[0].title, format!("{eighty}…"));
+}
