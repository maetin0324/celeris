+    /// The title in the digest heading and card: summaries longer than
+    /// [`COS_DIGEST_TITLE_MAX_CHARS`] code points keep that many and end with `…`.
+    pub fn digest_title(&self) -> String {
+        let title = self.title();
+        if self.summary.trim().is_empty() || title.chars().count() <= COS_DIGEST_TITLE_MAX_CHARS {
+            return title;
+        }
+        let mut cut: String = title.chars().take(COS_DIGEST_TITLE_MAX_CHARS).collect();
+        cut.push('…');
+        cut
+    }
 }
 
+/// Code points of an item summary kept in the digest heading and card title.
+pub const COS_DIGEST_TITLE_MAX_CHARS: usize = 80;
