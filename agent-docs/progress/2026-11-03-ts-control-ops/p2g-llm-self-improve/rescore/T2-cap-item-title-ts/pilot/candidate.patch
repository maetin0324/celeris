+describe("cos_digest title cap", () => {
+  const titleOf = (summary: string) => {
+    const p = post(input({ items: [item({ summary })] }));
+    const title = p.cards[0]?.title;
+    expect(p.text).toContain(`\n### ${title}（決定）\n`);
+    return title;
+  };
+
+  it("80 code points stay as they are", () => {
+    const s = "あ".repeat(80);
+    expect(titleOf(s)).toBe(s);
+  });
+
+  it("81 code points become the first 80 plus one ellipsis in the heading and the card", () => {
+    expect(titleOf("あ".repeat(81))).toBe(`${"あ".repeat(80)}…`);
+  });
+
+  it("counts code points, not UTF-16 units, and does not split a surrogate pair", () => {
+    const s = "😀".repeat(80);
+    expect(s.length).toBe(160);
+    expect(titleOf(s)).toBe(s);
+    expect(titleOf(`${s}x`)).toBe(`${s}…`);
+    expect(titleOf(`${"a".repeat(79)}😀😀`)).toBe(`${"a".repeat(79)}😀…`);
+  });
+
+  it("a long blank summary keeps source_kind:source_key", () => {
+    expect(titleOf(" ".repeat(100))).toBe("decision:decision:01TASK");
+  });
+
+  it("the other lines and fields do not change", () => {
+    const summary = "長".repeat(100);
+    const decision = packet({ summary });
+    const p = post(input({ items: [item({ summary, state: "escalated", decision })] }));
+    expect(p.text).toContain(`- 人が決めること: ${summary}\n`);
+    expect(p.cards[0]?.id).toBe("decision:01TASK");
+  });
+});
+
