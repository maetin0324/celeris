-/** Rust の `CosTriageItemReport::title`。 */
+/** 項目の見出しの上限（Unicode の code point で数える。UTF-16 の長さではない）。 */
+const TITLE_MAX_CODE_POINTS = 80;
+
+/** 上限を超えた見出しを、先頭の上限分の code point + `…` にする。 */
+function capTitle(summary: string): string {
+  const codePoints = Array.from(summary);
+  return codePoints.length > TITLE_MAX_CODE_POINTS
+    ? `${codePoints.slice(0, TITLE_MAX_CODE_POINTS).join("")}…`
+    : summary;
+}
+
+/** digest の `### ` の見出しと card の `title` の両方に使う見出し。空白だけなら `<source_kind>:<source_key>`。 */
 function title(item: CosTriageItemReport): string {
-  return rustTrim(item.summary) === "" ? `${item.source_kind}:${item.source_key}` : item.summary;
+  return rustTrim(item.summary) === "" ? `${item.source_kind}:${item.source_key}` : capTitle(item.summary);
 }
 
