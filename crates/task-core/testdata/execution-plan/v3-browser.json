  "stages": [
    {"key": "phase-1", "kind": "implement", "title": "Phase 1 MVP"},
    {"key": "phase-2", "kind": "implement", "title": "Phase 2 policy・credential", "review": "human"},
    {"key": "phase-3", "kind": "implement", "title": "Phase 3 identity・takeover"}
