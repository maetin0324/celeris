# ADR-0115 / ADR-0116: browser launcher（root が /etc/systemd/system に配置する system unit）。
# 専用 user celeris-browser として動き、userns の owner になる。daemon はこの unit を起動・変更できない。
# socket は celeris-browser-launcher.socket から socket activation（LISTEN_FDS）で受け取る。
[Unit]
Description=Celeris browser launcher (ADR-0115)
Requires=celeris-browser-launcher.socket
After=celeris-browser-launcher.socket network.target

[Service]
Type=simple
User=celeris-browser
Group=celeris-browser
# daemon の group・補助 group と共有しない。
SupplementaryGroups=
ExecStart=/usr/local/libexec/celeris/celeris-browser-launcher --config /etc/celeris-browser/launcher.toml
# 状態 dir（session 記録）: /var/lib/celeris-browser、celeris-browser だけが書ける。
StateDirectory=celeris-browser
StateDirectoryMode=0700
WorkingDirectory=/var/lib/celeris-browser
UMask=0077

# 回収: 停止時は cgroup の全 process（bwrap / sandboxd / Chrome / egress）を止める（ADR-0116 D6）。
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=on-failure
RestartSec=2

# 資源制限（ADR-0116 D2 の同時 session 2 を前提にした上限）。
TasksMax=1024
MemoryMax=6G
CPUQuota=400%
LimitNOFILE=8192
LimitCORE=0

# newuidmap / newgidmap（setuid root）で 2 map を張るため NoNewPrivileges は付けない。
# Chrome 側の no_new_privs と capability 全落としは bwrap が付ける（ADR-0115 ホスト側の準備 4）。
# user / net / mount namespace を作るため RestrictNamespaces・PrivateUsers は付けない。
# bwrap が子 userns 内で capability を使うため CapabilityBoundingSet は絞らない。host 側の capability は与えない。
AmbientCapabilities=
NoNewPrivileges=false
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/celeris-browser
PrivateTmp=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectClock=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
