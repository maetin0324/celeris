[Unit]
Description=Celeris browser credential broker (release %i)
After=celeris@%i.service
Requires=celeris@%i.service

[Service]
Type=simple
WorkingDirectory=%h/.local/celeris
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# launcher UID comes from the same config.toml as the daemon; never add a UID argument.
# credentiald snapshots the admitted daemon PID and its process start time.
ExecStart=/bin/sh -c 'pid=$(systemctl --user show --property=MainPID --value celeris@%i.service); test "$pid" -gt 1 && exec %h/.local/celeris/releases/%i/bin/celeris-credentiald serve --config %h/.config/celeris/config.toml "$pid"'
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
