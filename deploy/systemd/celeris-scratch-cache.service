[Unit]
# Celeris の階層 cache server（ADR-0075 D5 (b)、Phase G3）。sccache の webdav backend として
# `127.0.0.1:<[scratch.cache_server] port>`（既定 4237）で GET / PUT / PROPFIND / MKCOL / HEAD に答える。
# L1 = `<scratch>/cache-l1`（ローカル）、L2 = `[scratch.l2] dir`（既定 ~/.local/celeris/cache/sccache-l2、NFS）。
# PUT は L1 に書いてすぐ返し、L2 へは flusher が帯域制限（`[scratch.l2] flush_mbps`、既定 25 MB/s）つきで非同期に書く。
# `celeris@<sha12>` の cgroup の外で動かす（昇格の停止で巻き添えにしない。ADR-0060 と同じ教訓）。
# インストール: scripts/selfdeploy/install-units.sh（置くだけ）。有効化は人:
#   systemctl --user enable --now celeris-scratch-cache.service
#   systemctl --user restart celeris-sccache.service   # sccache の backend は起動時に決まる（U5）
# 昇格で自動的には再起動しない（`current` の celeris を使うのは起動時だけ。protocol を変えた版だけ人が再起動する）。
Description=Celeris tiered build cache server for sccache (ADR-0075 D5)
After=network.target
Before=celeris-sccache.service

[Service]
Type=simple
WorkingDirectory=%h/.local/celeris
Environment=CELERIS_CONFIG=%h/.config/celeris/config.toml
Environment=CELERIS_LOG=info
ExecStart=%h/.local/celeris/current/bin/celeris --config ${CELERIS_CONFIG} --log-format text cache-server
Restart=on-failure
RestartSec=5
# SIGTERM で待ち行列を `.pending` に残して止まる（次の起動で積み直す）。
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=false

[Install]
WantedBy=default.target
