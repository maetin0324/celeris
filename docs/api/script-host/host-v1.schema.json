{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "celeris:host v1",
  "description": "schema の根。Host API v1 の DTO を 1 つの文書に集める（値として使わない）。",
  "type": "object",
  "properties": {
    "capability": {
      "$ref": "#/$defs/Capability"
    },
    "cos_digest_list_runs_request": {
      "$ref": "#/$defs/CosDigestListRunsRequest"
    },
    "cos_digest_list_runs_result": {
      "$ref": "#/$defs/CosDigestListRunsReplyResult"
    },
    "cos_digest_read_run_request": {
      "$ref": "#/$defs/CosDigestReadRunRequest"
    },
    "cos_digest_read_run_result": {
      "$ref": "#/$defs/CosDigestInputResult"
    },
    "host_error": {
      "$ref": "#/$defs/HostError"
    },
    "selftest_echo_request": {
      "$ref": "#/$defs/SelftestEchoRequest"
    },
    "selftest_echo_result": {
      "$ref": "#/$defs/SelftestEchoReplyResult"
    },
    "version": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "capability",
    "host_error",
    "selftest_echo_request",
    "selftest_echo_result",
    "cos_digest_list_runs_request",
    "cos_digest_list_runs_result",
    "cos_digest_read_run_request",
    "cos_digest_read_run_result"
  ],
  "$defs": {
    "Capability": {
      "description": "bundle の manifest が宣言する capability。Rust は「宣言 ∩ 領域ごとの許可表」だけを有効にする。",
      "oneOf": [
        {
          "description": "試験用 async op `op_host_selftest_echo`（要求の scope の task を写し返すだけ）。",
          "type": "string",
          "const": "selftest:echo_task"
        },
        {
          "description": "`op_cos_digest_list_runs`: digest を待つ triage run の一覧（付記 S4-12）。",
          "type": "string",
          "const": "cos_digest:list_runs"
        },
        {
          "description": "`op_cos_digest_read_run`: その pass の一覧にある run 1 つの入力（付記 S4-12）。",
          "type": "string",
          "const": "cos_digest:read_run"
        }
      ]
    },
    "CosDigestInput": {
      "description": "`op_cos_digest_read_run` の戻り値（S4-2 の `CosDigestInput` のまま）。正本は task-core の\n`CosDigestInput`。`celeris-script` は task-core に依存しないので同じ形をここに持ち、\n`tests/dto.rs` が fixture の全行で両方の型を往復させて一致を確かめる。",
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CosTriageItemReport"
          }
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": "string"
        },
        "run_state": {
          "type": "string"
        },
        "thread": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "items",
        "reason",
        "run_id",
        "run_state",
        "thread"
      ]
    },
    "CosDigestInputResult": {
      "description": "op の戻り値。`celeris:host` は `ok` なら `value` を返し、`error` なら `HostError` を throw する。",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "ok"
            },
            "value": {
              "$ref": "#/$defs/CosDigestInput"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "$ref": "#/$defs/HostError"
            },
            "kind": {
              "type": "string",
              "const": "error"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "error"
          ]
        }
      ]
    },
    "CosDigestListRunsReply": {
      "description": "`op_cos_digest_list_runs` の戻り値。",
      "type": "object",
      "properties": {
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CosDigestRunRef"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "runs"
      ]
    },
    "CosDigestListRunsReplyResult": {
      "description": "op の戻り値。`celeris:host` は `ok` なら `value` を返し、`error` なら `HostError` を throw する。",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "ok"
            },
            "value": {
              "$ref": "#/$defs/CosDigestListRunsReply"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "$ref": "#/$defs/HostError"
            },
            "kind": {
              "type": "string",
              "const": "error"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "error"
          ]
        }
      ]
    },
    "CosDigestListRunsRequest": {
      "description": "`op_cos_digest_list_runs` の引数（欄なし。上限は Rust の定数で、TS は変えられない）。",
      "type": "object",
      "additionalProperties": false
    },
    "CosDigestReadRunRequest": {
      "description": "`op_cos_digest_read_run` の引数。その pass の一覧にある `(thread, run_id)` の組だけを読める。",
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string"
        },
        "thread": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "thread",
        "run_id"
      ]
    },
    "CosDigestRunRef": {
      "description": "digest を待つ triage run 1 つ（`started_at`・`run_id` 順）。",
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string"
        },
        "run_state": {
          "type": "string"
        },
        "thread": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "thread",
        "run_id",
        "run_state"
      ]
    },
    "CosTriageDecision": {
      "description": "人が決めること（outbox の本文）。正本は task-core の `CosTriageDecision`。",
      "type": "object",
      "properties": {
        "background": {
          "type": [
            "string",
            "null"
          ]
        },
        "on_answer": {
          "type": [
            "string",
            "null"
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CosTriageOption"
          }
        },
        "recommendation_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "recommended": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "type": "string"
        },
        "web_path": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "background",
        "on_answer",
        "options",
        "recommendation_reason",
        "recommended",
        "summary",
        "web_path"
      ]
    },
    "CosTriageItemReport": {
      "description": "`cos_inbox_items` の 1 行。正本は task-core の `CosTriageItemReport`。",
      "type": "object",
      "properties": {
        "created_at": {
          "type": "string"
        },
        "decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/CosTriageDecision"
            },
            {
              "type": "null"
            }
          ]
        },
        "detail": {
          "type": "string"
        },
        "item_id": {
          "type": "string"
        },
        "operation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "route": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_key": {
          "type": "string"
        },
        "source_kind": {
          "type": "string"
        },
        "source_revision": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "thread_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "created_at",
        "decision",
        "detail",
        "item_id",
        "operation_id",
        "reason",
        "route",
        "run_id",
        "source_key",
        "source_kind",
        "source_revision",
        "state",
        "summary",
        "thread_id"
      ]
    },
    "CosTriageOption": {
      "description": "元の待ちの選択肢 1 つ。正本は task-core の `CosTriageOption`（同じ形。`tests/dto.rs` が照合する）。",
      "type": "object",
      "properties": {
        "detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "detail",
        "key",
        "label"
      ]
    },
    "HostError": {
      "description": "Host API の誤り。op は `{ kind: \"error\", error }` で返し、`celeris:host` が `HostError` として throw する。",
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/HostErrorCode"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ]
    },
    "HostErrorCode": {
      "description": "`HostError.code`。[`ScriptError`] の種類と 1 対 1。",
      "type": "string",
      "enum": [
        "exception",
        "timeout",
        "busy",
        "invalid_output",
        "denied",
        "terminated",
        "generation_gone"
      ]
    },
    "SelftestEchoReply": {
      "description": "`op_host_selftest_echo` の戻り値（Rust → TS）。",
      "type": "object",
      "properties": {
        "at": {
          "$ref": "#/$defs/Timestamp"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "observation": {
          "$ref": "#/$defs/SelftestObservation"
        },
        "priority": {
          "$ref": "#/$defs/SelftestPriority"
        },
        "task_id": {
          "type": "string"
        },
        "tokens": {
          "$ref": "#/$defs/U64String"
        }
      },
      "additionalProperties": false,
      "required": [
        "at",
        "note",
        "observation",
        "priority",
        "task_id",
        "tokens"
      ]
    },
    "SelftestEchoReplyResult": {
      "description": "op の戻り値。`celeris:host` は `ok` なら `value` を返し、`error` なら `HostError` を throw する。",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "ok"
            },
            "value": {
              "$ref": "#/$defs/SelftestEchoReply"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "$ref": "#/$defs/HostError"
            },
            "kind": {
              "type": "string",
              "const": "error"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "error"
          ]
        }
      ]
    },
    "SelftestEchoRequest": {
      "description": "`op_host_selftest_echo` の引数（TS → Rust）。",
      "type": "object",
      "properties": {
        "at": {
          "$ref": "#/$defs/Timestamp"
        },
        "note": {
          "description": "無ければ `null`（欄は省かない）。",
          "type": [
            "string",
            "null"
          ]
        },
        "priority": {
          "$ref": "#/$defs/SelftestPriority"
        },
        "task_id": {
          "description": "対象の task の id（ULID の文字列）。要求の scope に無ければ `denied`。",
          "type": "string"
        },
        "tokens": {
          "description": "token 数など 2^53−1 を超えうる値。",
          "$ref": "#/$defs/U64String"
        }
      },
      "additionalProperties": false,
      "required": [
        "at",
        "note",
        "priority",
        "task_id",
        "tokens"
      ]
    },
    "SelftestObservation": {
      "description": "`op_host_selftest_echo` が見たもの（データ付きの enum の写像を確かめる）。",
      "oneOf": [
        {
          "description": "note があった。",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "noted"
            },
            "length": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "length"
          ]
        },
        {
          "description": "note が null だった。",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "empty"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "SelftestPriority": {
      "description": "試験用の優先度（unit の enum の写像を確かめる）。",
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high"
      ]
    },
    "Timestamp": {
      "description": "RFC 3339 の UTC 時刻（末尾 Z）",
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "U64String": {
      "description": "0 以上 2^64−1 以下の整数の 10 進表記（2^53−1 を超えうる値は number にしない）",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    }
  }
}
