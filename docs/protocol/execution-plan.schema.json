{
  "$defs": {
    "Check": {
      "description": "DESIGN §5.3/§5.7 の `Check` 種別。",
      "oneOf": [
        {
          "properties": {
            "cmd": {
              "type": "string"
            },
            "expect_exit": {
              "format": "int32",
              "type": "integer"
            },
            "type": {
              "const": "command",
              "type": "string"
            }
          },
          "required": [
            "type",
            "cmd",
            "expect_exit"
          ],
          "type": "object"
        },
        {
          "properties": {
            "name": {
              "type": "string"
            },
            "type": {
              "const": "artifact_exists",
              "type": "string"
            }
          },
          "required": [
            "type",
            "name"
          ],
          "type": "object"
        },
        {
          "description": "ADR-0067 D2: 知識ベースのページ参照（`task_core::knowledge::page_path` と同じ形。KB の根からの\n相対、`.md`、`..` 不可。実在の検証は組み立て時には行わない — `Check::ArtifactExists` と同様、\n人が確認するときに知識ベース側で気付く）。",
          "properties": {
            "path": {
              "type": "string"
            },
            "type": {
              "const": "knowledge_page",
              "type": "string"
            }
          },
          "required": [
            "type",
            "path"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "reviewer",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "human",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "CostOfReversal": {
      "description": "D7: 後戻りの大きさ。",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "type": "string"
    },
    "Criterion": {
      "description": "DESIGN §4.1 の `Criterion`。",
      "properties": {
        "check": {
          "$ref": "#/$defs/Check"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text",
        "check"
      ],
      "type": "object"
    },
    "DecisionOption": {
      "additionalProperties": false,
      "description": "D7: 選択肢 1 つ。",
      "properties": {
        "consequence": {
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "description": "`[a-z0-9-]{1,32}`。決定の中で一意。",
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "label"
      ],
      "type": "object"
    },
    "DecisionSpec": {
      "additionalProperties": false,
      "description": "D2 / D7: 計画に書く決定の形（`id` / `path` / `raised_by` / `status` は daemon が付ける）。",
      "properties": {
        "cost_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "cost_of_reversal": {
          "$ref": "#/$defs/CostOfReversal"
        },
        "key": {
          "description": "`[a-z0-9-]{1,32}`。計画の中で一意。",
          "type": "string"
        },
        "needed_before": {
          "default": [],
          "description": "止める unit の key か `stage:<key>`。計画の `decisions` では 1 件以上（何を止めるかを書かせる）。\nunit に書いた `decisions` では省略でき、その unit が補われる（D2 の糖衣）。",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "options": {
          "description": "2..=5 件。",
          "items": {
            "$ref": "#/$defs/DecisionOption"
          },
          "type": "array"
        },
        "question": {
          "type": "string"
        },
        "recommended": {
          "description": "`options` のどれかの key。",
          "type": "string"
        }
      },
      "required": [
        "key",
        "question",
        "options",
        "recommended",
        "cost_of_reversal"
      ],
      "type": "object"
    },
    "ExecutionChildSpec": {
      "additionalProperties": false,
      "description": "ADR-0074 D3.7（Phase F4b (f)）: planner が提案する子 Task 1 件（`delegate` メッセージと同じ中身。\n`assignee` / `tier` / `model` は持たない〈担当は matching が決める。ADR-0069 D1〉）。",
      "properties": {
        "acceptance": {
          "description": "1 件以上。",
          "items": {
            "$ref": "#/$defs/Criterion"
          },
          "type": "array"
        },
        "depends_on": {
          "default": [],
          "description": "同じ `children` の中の他の子の key。",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "features": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskFeatureHints"
            },
            {
              "type": "null"
            }
          ],
          "description": "ADR-0069 D3: `TaskFeatureHints` の上書きヒント。"
        },
        "genre": {
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "description": "`[a-z0-9-]{1,32}`。`children` の中で一意（WU の key とは別の名前空間。`child:<key>` で指す）。",
          "type": "string"
        },
        "objective": {
          "type": "string"
        },
        "skills": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "title",
        "objective",
        "acceptance"
      ],
      "type": "object"
    },
    "ExecutionMode": {
      "description": "D13: atomic / compound の判定結果。",
      "enum": [
        "atomic",
        "compound"
      ],
      "type": "string"
    },
    "Level": {
      "description": "各軸の段階（小さな順序尺度）。",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "type": "string"
    },
    "PhaseSpec": {
      "additionalProperties": false,
      "description": "ADR-0074 D1.1（Phase F2）: `celeris.execution-plan/2` の工程。配列の順が実行順（D1.1）。",
      "properties": {
        "key": {
          "description": "`[a-z0-9-]{1,32}`。計画の中で一意。",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/WorkUnitKind"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "kind",
        "title"
      ],
      "type": "object"
    },
    "PlanUnitSpec": {
      "additionalProperties": false,
      "description": "ADR-0079 D2: /3 の unit。`kind = task` なら子 task（`acceptance` 必須、`checks` / `budget` /\n`harness` / `context.paths` は持たない）、それ以外は leaf（今の WorkUnit の欄 + `needs_decisions`。\n`checks` 1 本以上）。`assignee` / `tier` / `model` / `lane` は持たない（`deny_unknown_fields`）。",
      "properties": {
        "acceptance": {
          "items": {
            "$ref": "#/$defs/Criterion"
          },
          "type": "array"
        },
        "adopt": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskId"
            },
            {
              "type": "null"
            }
          ],
          "description": "D15: 既存の task をこの unit の子として採用する（人の計画〈origin human〉だけ）。"
        },
        "budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkUnitBudget"
            },
            {
              "type": "null"
            }
          ]
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/WorkUnitCheck"
          },
          "type": "array"
        },
        "context": {
          "$ref": "#/$defs/UnitContext"
        },
        "decisions": {
          "description": "この unit が持ち込む決定（計画の `decisions` に `needed_before: [<この unit>]` を付けて移した\nものとして読む。D2 の糖衣）。",
          "items": {
            "$ref": "#/$defs/DecisionSpec"
          },
          "type": "array"
        },
        "depends_on": {
          "default": [],
          "description": "unit の key（leaf・task を問わない）。/2 の `child:<key>` は書けない。",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "done_when": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "expected_write_paths": {
          "description": "Optional repository-relative prefixes inherited by child tasks or leaf WUs.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "features": {
          "description": "ADR-0069 D3: `TaskFeatureHints` の上書きヒント。"
        },
        "gate": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionMode"
            },
            {
              "type": "null"
            }
          ],
          "description": "ADR-0079「R6-2」: 子 task の Complexity Gate の明示（`compound` = 子は自分の計画を持つ、`atomic` = 子は計画を\n持たず 1 つの節点として走る）。子の `routing.execution_hint = {<gate>, explicit: true}`。省いたら\n`compound`（kind task を選んだこと自体が「自分の計画が要る」の意味。`tree::task_unit_execution_hint`）。\n人の計画・planner の計画のどちらも書ける。leaf には書けない。"
        },
        "genre": {
          "type": [
            "string",
            "null"
          ]
        },
        "harness": {
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "description": "`[a-z0-9-]{1,32}`。計画の中で一意。",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/WorkUnitKind"
        },
        "needs_decisions": {
          "description": "回答を待つ決定の key（計画の `decisions`・unit の `decisions`）。",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "objective": {
          "type": "string"
        },
        "outputs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "repos": {
          "description": "親の repos の部分集合（repo の名前。子の生成〈R1b〉で検証する）。",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "skills": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "stage": {
          "description": "`stages` の key。",
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "stage",
        "kind",
        "title",
        "objective"
      ],
      "type": "object"
    },
    "RepoSelector": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      ],
      "description": "ADR-0079 D4 (2): leaf の `context.repo`（1 つの文字列、または配列。leaf は高々 1 つ）。"
    },
    "StageReview": {
      "description": "ADR-0079 D2 / D5: 段階の後の人の確認（`review: human` は ADR-0074 D2 の `pause_after` をその段階に\n指定したのと同じ意味。既定 none）。",
      "enum": [
        "none",
        "human"
      ],
      "type": "string"
    },
    "StageSpec": {
      "additionalProperties": false,
      "description": "ADR-0079 D2: /3 の段階（/2 の `PhaseSpec` に `review` を足した形）。",
      "properties": {
        "key": {
          "description": "`[a-z0-9-]{1,32}`。計画の中で一意。`work_units.phase` の値になる。",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/WorkUnitKind"
        },
        "review": {
          "$ref": "#/$defs/StageReview"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "kind",
        "title"
      ],
      "type": "object"
    },
    "TaskFeatureHints": {
      "additionalProperties": false,
      "description": "ADR-0069 D3: `TaskFeatures` の明示の上書き（書いた軸だけが勝つ）。API の `features` と CoS の\n`create_task.features` から入る（features は「仕事の性質の記述」であってモデルの選択ではない）。\nADR-0074 D5.1（Phase F1）: `deny_unknown_fields`（`lane`/`assignee`/`tier`/`model` のような\n担当・モデルの選択を紛れ込ませない。書けば schema 違反として計画の検証エラーになる）。",
      "properties": {
        "ambiguity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Level"
            },
            {
              "type": "null"
            }
          ]
        },
        "consequence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Level"
            },
            {
              "type": "null"
            }
          ]
        },
        "context_size": {
          "anyOf": [
            {
              "$ref": "#/$defs/Level"
            },
            {
              "type": "null"
            }
          ]
        },
        "cross_cutting": {
          "anyOf": [
            {
              "$ref": "#/$defs/Level"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_length": {
          "anyOf": [
            {
              "$ref": "#/$defs/Level"
            },
            {
              "type": "null"
            }
          ]
        },
        "judgment": {
          "anyOf": [
            {
              "$ref": "#/$defs/Level"
            },
            {
              "type": "null"
            }
          ]
        },
        "reversibility": {
          "anyOf": [
            {
              "$ref": "#/$defs/Level"
            },
            {
              "type": "null"
            }
          ]
        },
        "tool_intensity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Level"
            },
            {
              "type": "null"
            }
          ]
        },
        "verifiability": {
          "anyOf": [
            {
              "$ref": "#/$defs/Level"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "TaskId": {
      "description": "タスクの一意識別子（ULID）。DESIGN §4.1。",
      "type": "string"
    },
    "UnitContext": {
      "additionalProperties": false,
      "description": "ADR-0079 D2: /3 の unit の context（/1・/2 の `WorkUnitContext` に `repo` を足した形）。",
      "properties": {
        "from_work_units": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "knowledge": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "repo": {
          "anyOf": [
            {
              "$ref": "#/$defs/RepoSelector"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "WorkUnitBudget": {
      "additionalProperties": false,
      "description": "D14/D18: WU ごとの予算（任意。書かなければ D18 の既定を使う）。",
      "properties": {
        "max_turns": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_wall_secs": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "WorkUnitCheck": {
      "additionalProperties": false,
      "description": "D14: `checks` は決定的な検査だけ（`Command`。E4 で実行する。E2 は schema と検証のみ）。",
      "properties": {
        "cmd": {
          "type": "string"
        },
        "expect_exit": {
          "default": 0,
          "format": "int32",
          "type": "integer"
        }
      },
      "required": [
        "cmd"
      ],
      "type": "object"
    },
    "WorkUnitContext": {
      "additionalProperties": false,
      "description": "D14: WU が読むべき context のヒント。",
      "properties": {
        "from_work_units": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "knowledge": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "paths": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "WorkUnitKind": {
      "description": "D14: WorkUnit の種類。",
      "oneOf": [
        {
          "enum": [
            "investigate",
            "design",
            "implement",
            "test",
            "release",
            "repair",
            "other"
          ],
          "type": "string"
        },
        {
          "const": "integrate",
          "description": "ADR-0074 D1.4（Phase F2）: 工程末尾の統合 WU（daemon が計画の採用時に足す system WU。\n`runs = 0`、LLM run を起こさない）。planner の出力に書かれていれば検証で拒否する\n（`validate` の `ReservedKind`。system WU 専用の予約語）。",
          "type": "string"
        },
        {
          "const": "task",
          "description": "ADR-0079 D2（Phase R1a）: 子 task の unit（`celeris.execution-plan/3` だけ。/1・/2 では検証で拒否）。\n`work_units` の行は子 task の代理で、LLM run を起こさない（子 task の生成は R1b）。",
          "type": "string"
        }
      ]
    },
    "WorkUnitSpec": {
      "additionalProperties": false,
      "description": "D14: 計画の中の 1 WorkUnit の spec。**`assignee` / `tier` / `model` の欄は持たない**\n（`deny_unknown_fields` により、書かれていれば schema 違反になる。D14）。",
      "properties": {
        "budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorkUnitBudget"
            },
            {
              "type": "null"
            }
          ]
        },
        "checks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/WorkUnitCheck"
          },
          "type": "array"
        },
        "context": {
          "$ref": "#/$defs/WorkUnitContext",
          "default": {
            "from_work_units": [],
            "knowledge": [],
            "paths": []
          }
        },
        "depends_on": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "done_when": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "features": {
          "description": "D21: `TaskFeatures` の上書きヒント（任意の JSON。E3 以降の routing が読む）。"
        },
        "harness": {
          "description": "`[[genres]]` にある id だけを許す（D14。検証は担当の profile を知る呼び出し側が行う。\nここでは形だけ見る）。",
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "description": "`[a-z0-9-]{1,32}`。計画の中で一意（D14）。",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/WorkUnitKind"
        },
        "objective": {
          "type": "string"
        },
        "outputs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "phase": {
          "description": "ADR-0074 D1.1（Phase F2）: `celeris.execution-plan/2` では必須（`phases` にある key の\nいずれか）。`celeris.execution-plan/1` では無い（`Some` なら検証エラー。v1 の計画・\nプロンプトを 1 バイトも変えないため、この欄自体は常に存在するが v1 は `None` のまま）。",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "kind",
        "title",
        "objective"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "D14: Planner の出力（または人が `PUT`/`POST` で書く計画）そのもの。\n\nADR-0074 D1.1（Phase F2）: `schema` の値で v1 / v2 を分ける（`validate` が判定する）。\n`phases` / `children` は v1 では常に空（`serde(default)` で省略も読める。v1 の JSON を\n1 バイトも変えないため、この 2 欄自体は型として増えるが v1 の出力・検証は変わらない）。",
  "properties": {
    "children": {
      "default": [],
      "description": "ADR-0074 D3.7（Phase F4b (f)）: 子 Task の提案（v2 のみ。v1 では空でなければならない）。\n採用と同じトランザクションで既存の委譲の検証を通して子 Task になり、WU は\n`depends_on: [\"child:<key>\"]` でその子の `done` を待てる。",
