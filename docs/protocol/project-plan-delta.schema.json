{
  "$defs": {
    "Check": {
      "description": "DESIGN §5.3/§5.7 の `Check` 種別。",
      "oneOf": [
        {
          "properties": {
            "cmd": {
              "type": "string"
            },
            "expect_exit": {
              "format": "int32",
              "type": "integer"
            },
            "type": {
              "const": "command",
              "type": "string"
            }
          },
          "required": [
            "type",
            "cmd",
            "expect_exit"
          ],
          "type": "object"
        },
        {
          "properties": {
            "name": {
              "type": "string"
            },
            "type": {
              "const": "artifact_exists",
              "type": "string"
            }
          },
          "required": [
            "type",
            "name"
          ],
          "type": "object"
        },
        {
          "description": "ADR-0067 D2: 知識ベースのページ参照（`task_core::knowledge::page_path` と同じ形。KB の根からの\n相対、`.md`、`..` 不可。実在の検証は組み立て時には行わない — `Check::ArtifactExists` と同様、\n人が確認するときに知識ベース側で気付く）。",
          "properties": {
            "path": {
              "type": "string"
            },
            "type": {
              "const": "knowledge_page",
              "type": "string"
            }
          },
          "required": [
            "type",
            "path"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "reviewer",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "human",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "Criterion": {
      "description": "DESIGN §4.1 の `Criterion`。",
      "properties": {
        "check": {
          "$ref": "#/$defs/Check"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text",
        "check"
      ],
      "type": "object"
    },
    "ExecutionMode": {
      "description": "D13: atomic / compound の判定結果。",
      "enum": [
        "atomic",
        "compound"
      ],
      "type": "string"
    },
    "Level": {
      "description": "各軸の段階（小さな順序尺度）。",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "type": "string"
    },
    "MilestoneModify": {
      "additionalProperties": false,
      "description": "D3.4: 既存のマイルストーン 1 件の変更（書いた欄だけを変える。`key` は変えられない）。",
      "properties": {
        "acceptance": {
          "items": {
            "$ref": "#/$defs/Criterion"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "depends_on": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "execution": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "features": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskFeatureHints"
            },
            {
              "type": "null"
            }
          ]
        },
        "genre": {
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "type": "string"
        },
        "objective": {
          "type": [
            "string",
            "null"
          ]
        },
        "pause_after": {
          "anyOf": [
            {
              "$ref": "#/$defs/PausePolicy"
            },
            {
              "type": "null"
            }
          ]
        },
        "reach_criteria": {
          "type": [
            "string",
            "null"
          ]
        },
        "repos": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "skills": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "key"
      ],
      "type": "object"
    },
    "MilestoneSpec": {
      "additionalProperties": false,
      "description": "D3.3: 1 マイルストーンの spec。`assignee` / `tier` / `model` / `lane` は持たない\n（`deny_unknown_fields`。ADR-0069 D1: 担当は matching が決める）。",
      "properties": {
        "acceptance": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Criterion"
          },
          "type": "array"
        },
        "depends_on": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "execution": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionMode"
            },
            {
              "type": "null"
            }
          ],
          "description": "ADR-0072 D13 のヒント（+2）。"
        },
        "features": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskFeatureHints"
            },
            {
              "type": "null"
            }
          ],
          "description": "ADR-0069 D3: `TaskFeatureHints` の上書きヒント（型として検証する。D5.1 と同じ規律）。"
        },
        "genre": {
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "description": "`[a-z0-9-]{1,32}`。計画の中で一意。",
          "type": "string"
        },
        "objective": {
          "type": "string"
        },
        "pause_after": {
          "anyOf": [
            {
              "$ref": "#/$defs/PausePolicy"
            },
            {
              "type": "null"
            }
          ],
          "description": "ADR-0074 D2.1 / D3.3（Phase F4b）: このマイルストーン Task の途中確認（F3 の `PausePolicy`）。\n書かなければ既定（止めない）。"
        },
        "reach_criteria": {
          "description": "何が示せたら途中目標の達成か（人の判定の材料。SPEC §7「検証の合格線」）。",
          "type": "string"
        },
        "repos": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "skills": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "title",
        "objective",
        "reach_criteria"
      ],
      "type": "object"
    },
    "PausePolicy": {
      "description": "D2.1: `NewTaskSpec.pause_after` / `PATCH` / `PUT /tasks/{id}/execution/pause-after` /\nCoS の `create_task.pause_after` に書ける値。既定は `None`（全工程自動）。\n**planner は書けない**（`ExecutionPlanSpec` に欄が無い。`deny_unknown_fields` で拒否される）。",
      "oneOf": [
        {
          "description": "既定。全工程自動（統合の後で止まらない）。",
          "properties": {
            "mode": {
              "const": "none",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "description": "最後の工程を除くすべての工程の後で止まる。",
          "properties": {
            "mode": {
              "const": "each_phase",
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        {
          "description": "挙げた工程（`key` か `kind` に一致するもの）の後で止まる。",
          "properties": {
            "mode": {
              "const": "after",
              "type": "string"
            },
            "phases": {
              "default": [],
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        }
      ]
    },
    "TaskFeatureHints": {
      "additionalProperties": false,
      "description": "ADR-0069 D3: `TaskFeatures` の明示の上書き（書いた軸だけが勝つ）。API の `features` と CoS の\n`create_task.features` から入る（features は「仕事の性質の記述」であってモデルの選択ではない）。\nADR-0074 D5.1（Phase F1）: `deny_unknown_fields`（`lane`/`assignee`/`tier`/`model` のような\n担当・モデルの選択を紛れ込ませない。書けば schema 違反として計画の検証エラーになる）。",
      "properties": {
        "ambiguity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Level"
            },
            {
              "type": "null"
            }
          ]
        },
        "consequence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Level"
            },
            {
              "type": "null"
            }
          ]
        },
        "context_size": {
          "anyOf": [
            {
              "$ref": "#/$defs/Level"
            },
            {
              "type": "null"
            }
          ]
        },
        "cross_cutting": {
          "anyOf": [
            {
              "$ref": "#/$defs/Level"
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_length": {
          "anyOf": [
            {
              "$ref": "#/$defs/Level"
            },
            {
              "type": "null"
            }
          ]
        },
        "judgment": {
          "anyOf": [
            {
              "$ref": "#/$defs/Level"
            },
            {
              "type": "null"
            }
          ]
        },
        "reversibility": {
          "anyOf": [
            {
              "$ref": "#/$defs/Level"
            },
            {
              "type": "null"
            }
          ]
        },
        "tool_intensity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Level"
            },
            {
              "type": "null"
            }
          ]
        },
        "verifiability": {
          "anyOf": [
            {
              "$ref": "#/$defs/Level"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "D3.4: replan の run が `<artifacts>/project-plan.json` に書く差分。",
  "properties": {
    "add": {
      "default": [],
      "description": "新しいマイルストーン（key は既存のどれとも衝突しない）。",
      "items": {
        "$ref": "#/$defs/MilestoneSpec"
      },
      "type": "array"
    },
    "base_version": {
      "description": "この差分の元になった（承認済みの）版。現行の版と違えば古い差分として拒む。",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "cancel": {
      "default": [],
      "description": "走っている・まだ終わっていないマイルストーンを明示して取り下げる（承認で `Cancel` を適用）。",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "modify": {
      "default": [],
      "description": "まだ dispatch されていないマイルストーンの変更。",
      "items": {
        "$ref": "#/$defs/MilestoneModify"
      },
      "type": "array"
    },
    "rationale": {
      "type": "string"
    },
    "remove": {
      "default": [],
      "description": "まだ dispatch されていないマイルストーンを計画から外す。",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "schema": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "base_version",
    "rationale"
  ],
  "title": "ProjectPlanDelta",
  "type": "object"
}
