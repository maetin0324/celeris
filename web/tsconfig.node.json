{
  "extends": "./tsconfig.json",
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "server/**/*",
    "scripts/**/*",
    "e2e/**/*",
    "test/**/*"
  ],
  "exclude": [
    "e2e/parity/realtime.spec.ts",
    "e2e/parity/console.spec.ts",
    "e2e/parity/latency-gate.spec.ts",
    "e2e/support/node-event-source.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023"],
    "types": ["node"],
    "target": "ES2023",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "resolveJsonModule": true
  }
}
